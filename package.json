{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "Cross-session persistent memory for DeepSeek Harness: scoped Markdown notes, session capture, prompt injection, and memory tools.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "index.js",
    "lib/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglarek/dsh-memory.git"
  },
  "homepage": "https://github.com/douglarek/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/douglarek/dsh-memory/issues"
  }
}
